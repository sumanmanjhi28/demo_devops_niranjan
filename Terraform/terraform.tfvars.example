# AWS Configuration
aws_region = "us-east-1"

# Application Configuration
app_name = "demo-devops"
env_name = "dev"

# EKS Configuration
instance_type = "t3.medium"
min_size      = 1
max_size      = 3
desired_size  = 2
eks_version   = "1.31"

# Elastic Beanstalk Configuration (Optional)
# Set to true to provision Elastic Beanstalk alongside EKS
enable_elastic_beanstalk = false
eb_instance_type         = "t3.micro"
eb_solution_stack        = "64bit Amazon Linux 2023 v6.2.0 running Node.js 20"
eb_min_instances         = 1
eb_max_instances         = 2

# Network Configuration
vpc_cidr = "10.0.0.0/16"

# Tags
tags = {
  Terraform   = "true"
  Environment = "dev"
  Project     = "demo-devops"
}
